rules_version = '2';

// Reglas de seguridad de Cloud Firestore de CodeMentor AI.
// Cada usuario solo puede leer y escribir sus propios datos: el documento users/{uid} y todo
// lo que cuelga de él (progress/curriculum, progress/glitchCity). Nada más es accesible.
// Copia versionada de las reglas publicadas en la consola de Firebase; para publicarlas desde
// la terminal: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
